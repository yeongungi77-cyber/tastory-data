    "모츠나베": {"ja": "もつ鍋", "info": {"desc": "소 곱창에 양배추·부추·마늘을 듬뿍 넣고 간장 또는 미소 국물로 끓이는 후쿠오카식 곱창 전골입니다.", "taste": "곱창의 고소한 지방감 · 마늘향 · 달큰한 채소 국물", "tip": "건더기를 다 먹은 뒤 짬뽕면을 넣어 마무리하는 것이 정석입니다."}},
    "미즈타키": {"ja": "水炊き", "info": {"desc": "닭 뼈를 오래 고아 뽀얗게 우린 육수에 닭고기와 채소를 익혀 먹는 하카타식 닭 전골입니다.", "taste": "담백하면서 깊은 닭 육수 · 폰즈의 산뜻한 산미", "tip": "첫 잔은 국물만 맛보고, 마지막엔 밥과 달걀로 죽(조스이)을 만들어 먹습니다."}},
    "고마사바": {"ja": "ごまさば", "info": {"desc": "신선한 고등어회를 간장과 참깨 소스에 버무린 후쿠오카 향토 요리입니다. 고등어를 날로 먹는 드문 지역 음식입니다.", "taste": "고등어의 기름진 감칠맛 · 참깨의 고소함 · 간장의 짭짤함", "tip": "술안주로 먹거나 밥 위에 올려 뜨거운 차를 부어 차즈케로 즐기기도 합니다."}},
    "야타이": {"ja": "屋台", "info": {"desc": "나카스·텐진 일대에 저녁마다 들어서는 후쿠오카의 포장마차 거리입니다. 라멘·오뎅·꼬치 등을 파는 작은 노점에서 현지인과 함께 먹습니다.", "taste": "가게마다 다름 · 라멘, 오뎅, 야키토리, 교자가 대표 메뉴", "tip": "좌석이 8~10석 안팎이라 대기가 흔하고, 현금만 받는 곳도 있습니다. 비 오는 날은 쉬는 곳이 많습니다."}},
    "멘타이코": {"ja": "明太子", "info": {"desc": "명태 알을 고춧가루 양념에 절인 매콤한 명란젓(가라시멘타이코)으로, 후쿠오카를 대표하는 명물이자 기념품입니다.", "taste": "짭짤하고 매콤한 감칠맛 · 톡톡 터지는 알 식감", "tip": "밥·오니기리와 가장 잘 맞고, 멘타이코 덮밥·파스타·구이로도 즐깁니다. 기념품으로 살 때는 냉장 보관이 필요합니다."}},
    "하카타 교자": {"ja": "博多一口餃子", "info": {"desc": "한입에 쏙 들어가는 작은 크기의 군만두(히토쿠치 교자)입니다. 얇은 피를 바삭하게 구워 내는 하카타식 교자입니다.", "taste": "바삭한 피 · 육즙 있는 작은 소 · 가벼운 식감", "tip": "크기가 작아 한 접시에 여러 개가 나오고, 맥주 안주로 인기가 많습니다. 야타이에서도 자주 볼 수 있습니다."}},
    "야키토리": {"ja": "焼き鳥", "info": {"desc": "꼬치구이 가게를 통틀어 부르는 말로, 후쿠오카에서는 닭뿐 아니라 돼지 삼겹살 꼬치(부타바라)가 대표 메뉴입니다.", "taste": "숯불 향 · 소금(시오) 또는 달큰한 양념(타레) · 기름진 삼겹살", "tip": "초간장을 뿌린 생양배추가 곁들여 나오는 가게가 많습니다. 여러 가지를 조금씩 시켜 맛보는 것이 일반적입니다."}},
    "고보텐 우동": {"ja": "ごぼう天うどん", "info": {"desc": "가늘게 썬 우엉 튀김(고보텐)을 올린 하카타식 우동입니다. 하카타 우동은 면이 부드럽고 국물이 맑은 것이 특징입니다.", "taste": "부드러운 면 · 은은한 다시 국물 · 바삭한 우엉 튀김", "tip": "튀김을 국물에 적셔 부드럽게 먹어도 맛있습니다. 어묵 튀김(마루텐)을 올린 우동도 함께 인기 있는 메뉴입니다."}},
    "텐푸라": {"ja": "天ぷら", "info": {"desc": "후쿠오카에는 카운터 앞에서 튀기자마자 한 점씩 바로 내주는 정식 스타일 튀김집이 많아, 합리적인 가격에 갓 튀긴 텐푸라를 먹을 수 있습니다.", "taste": "얇고 바삭한 튀김옷 · 재료 본연의 맛", "tip": "점심·저녁 모두 줄이 생기는 인기 가게가 많습니다. 정식에는 밥·된장국이 함께 나오는 경우가 일반적입니다."}},
    "카이센동": {"ja": "海鮮丼", "info": {"desc": "신선한 회와 해산물을 밥 위에 듬뿍 올린 덮밥입니다. 바다에 접한 후쿠오카는 시장 근처에서 신선한 카이센동을 먹기 좋습니다.", "taste": "신선한 회의 단맛 · 간장·와사비 · 초밥보다 푸짐한 양", "tip": "야나기바시 연합시장 같은 시장 주변 식당은 아침·점심 영업이 중심이라, 일찍 가면 고를 수 있는 메뉴가 많습니다."}},
    "복어·아라": {"ja": "ふぐ・あら料理", "search": ["ふぐ料理", "あら料理", "クエ"], "match": ["クエ", "くえ料理", "あら鍋", "アラ鍋", "あら料理"], "diet": ["raw_food"], "taste": ["sashimi"], "info": {"desc": "복어(후구)와 아라(쿠에 — 규슈에서 부르는 대형 바닷물고기)를 회·전골·코스로 즐기는 요리입니다. 후쿠오카는 시모노세키와 가까워 복어 가게가 많습니다.", "taste": "쫄깃하고 담백한 회 · 폰즈의 산미 · 진한 생선 육수 전골", "tip": "복어는 면허가 있는 요리사만 다룹니다. 제철은 겨울이고, 코스는 예약하는 편이 좋습니다."}},
    "오코노미야키": {"ja": "お好み焼き", "info": {"desc": "양배추를 넣은 반죽에 돼지고기·해물 등을 올려 철판에 굽는 부침입니다. 후쿠오카에는 하카타식 철판집과 히로시마식(면을 겹쳐 굽는) 가게가 함께 있습니다.", "taste": "고소한 반죽 · 달콤짭짤한 소스와 마요네즈", "tip": "가게마다 섞어 굽는 오사카식, 겹쳐 굽는 히로시마식이 달라요. 밀가루·달걀이 들어갑니다."}},
    "덮밥": {"ja": "丼もの", "search": ["丼", "丼もの"], "info": {"desc": "밥 위에 튀김·고기·달걀 같은 주재료를 올려 한 그릇으로 내는 음식입니다(텐동·가츠동·오야코동·규동 등).", "taste": "주재료와 달짝지근한 간장 양념", "tip": "빨리 먹을 수 있어 점심에 좋아요. 해산물 덮밥은 카이센동 칸에 있어요."}},
    "정식": {"ja": "定食", "search": ["定食"], "info": {"desc": "밥·국·반찬에 튀김·구이 같은 주요리를 한 상으로 묶어 내는 일본식 한 끼입니다.", "taste": "주요리에 따라 다름", "tip": "점심에 많이 먹어요. 밥 곱빼기나 리필이 되는 가게도 있어요."}},
    "킷사텐": {"ja": "喫茶店", "search": ["喫茶店"], "match": ["喫茶店", "純喫茶", "kissaten"], "info": {"desc": "핸드드립 커피와 토스트·나폴리탄·푸딩 같은 가벼운 음식을 내는 일본식 옛 찻집입니다. 오래된 인테리어를 그대로 지키는 가게가 많습니다.", "taste": "진한 드립 커피 · 단단한 커스터드 푸딩 · 케첩 맛 나폴리탄", "tip": "아침 모닝 세트를 내는 곳이 많아요. 실내 흡연이 되는 가게도 있으니 확인하세요."}},
    "바": {"ja": "バー", "search": ["バー"], "info": {"desc": "칵테일·위스키·와인을 중심으로 술을 마시는 곳입니다. 카운터 너머 바텐더와 이야기하며 마시는 작은 가게가 많습니다.", "taste": "가게마다 다름", "tip": "자릿값(차지)을 따로 받는 가게가 많아요. 일본은 만 20세부터 술을 마실 수 있어요."}},
    "크래프트 맥주": {"ja": "クラフトビール", "search": ["クラフトビール"], "match": ["クラフトビール", "craft beer", "ブルワリー", "brewery", "ビアバー"], "info": {"desc": "작은 양조장에서 만든 다양한 맥주를 탭으로 골라 마시는 가게입니다. 규슈·후쿠오카 양조장 맥주를 내는 곳도 있습니다.", "taste": "가볍고 상큼한 에일부터 쓴맛 강한 IPA·흑맥주까지", "tip": "작은 잔으로 여러 종류를 맛볼 수 있는 가게가 많아요. 만 20세부터 마실 수 있어요."}},
    "스키야키": {"ja": "すき焼き", "search": ["すき焼き"], "match": ["すき焼き", "すき焼", "スキヤキ", "sukiyaki"], "allergy": ["egg", "soy", "wheat"], "diet": ["beef"], "taste": ["nabe"], "info": {"desc": "얇게 썬 소고기를 간장·설탕 양념으로 달게 졸여 날달걀에 찍어 먹는 냄비 요리입니다.", "taste": "달짝지근한 간장 양념 · 부드러운 소고기 · 날달걀의 고소함", "tip": "날달걀이 걱정되면 달걀 없이 먹어도 됩니다. 점심 정식을 내는 가게도 있어요."}},
    "샤부샤부": {"ja": "しゃぶしゃぶ", "search": ["しゃぶしゃぶ"], "match": ["しゃぶしゃぶ", "shabu-shabu"], "diet": ["beef", "pork"], "taste": ["nabe"], "info": {"desc": "얇게 썬 고기를 끓는 육수에 살짝 흔들어 익혀 폰즈·참깨 소스에 찍어 먹는 냄비 요리입니다.", "taste": "담백한 고기 · 새콤한 폰즈 · 고소한 참깨 소스", "tip": "소고기·돼지고기·흑돼지 등 고기를 고를 수 있고, 무한 리필(타베호다이) 가게도 많아요."}},
    "가라아게": {"ja": "唐揚げ", "search": ["唐揚げ"], "match": ["唐揚げ", "から揚げ", "からあげ", "唐揚", "唐あげ", "karaage"], "allergy": ["wheat"], "diet": ["chicken"], "info": {"desc": "간장·생강·마늘로 밑간한 닭고기에 밀가루·전분을 묻혀 튀긴 일본식 닭튀김입니다. 규슈는 가라아게 전문점이 많은 지역입니다.", "taste": "바삭한 겉 · 육즙 많은 닭다리살 · 간장 마늘 향", "tip": "정식·도시락·포장으로도 많이 팔아요. 레몬을 뿌릴지는 함께 먹는 사람에게 먼저 물어보는 게 예의예요."}},
    "치킨난반": {"ja": "チキン南蛮", "search": ["チキン南蛮"], "match": ["チキン南蛮", "ちきん南蛮", "chicken nanban"], "allergy": ["egg", "wheat"], "diet": ["chicken"], "info": {"desc": "달걀물을 입혀 튀긴 닭고기를 새콤달콤한 식초 양념(난반즈)에 적시고 타르타르 소스를 올린 미야자키 음식입니다.", "taste": "새콤달콤한 양념 · 고소한 타르타르 소스 · 부드러운 닭고기", "tip": "정식 메뉴로 많이 나와요. 타르타르 소스에 달걀·마요네즈가 들어갑니다."}},
    "쿠시카츠": {"ja": "串カツ", "search": ["串カツ"], "match": ["串カツ", "串かつ", "串揚げ", "串あげ", "串揚", "kushikatsu", "kushiage"], "allergy": ["egg", "wheat"], "diet": ["beef", "pork"], "taste": ["tonkatsu"], "info": {"desc": "고기·해산물·채소를 꼬치에 꿰어 빵가루를 입혀 튀긴 음식입니다. 오사카가 본고장이고 후쿠오카에도 꼬치튀김(쿠시아게) 가게가 있습니다.", "taste": "얇고 바삭한 튀김옷 · 소스 · 재료마다 다른 맛", "tip": "같이 쓰는 소스 통에는 한 번만 찍는 가게가 많아요(두 번 찍기 금지)."}},
    "카레": {"ja": "カレー", "search": ["カレー"], "allergy": ["wheat"], "taste": ["curry"], "info": {"desc": "밀가루 루로 걸쭉하게 만든 일본식 카레부터 향신료를 쓴 스파이스 카레까지 밥과 함께 먹는 카레 가게입니다. 후쿠오카는 스파이스 카레 가게가 많은 도시입니다.", "taste": "가게마다 다름 — 달큰한 일본식 루부터 향신료가 강한 스파이스 카레까지", "tip": "매운 정도·밥 양을 고를 수 있는 가게가 많아요. 일본식 루에는 밀가루가 들어가는 경우가 많습니다."}},
    "스프 카레": {"ja": "スープカレー", "search": ["スープカレー"], "match": ["スープカレー", "スープカリー", "soup curry"], "diet": ["chicken"], "taste": ["curry"], "info": {"desc": "향신료를 넣은 묽은 국물 카레에 큼직한 닭다리·구운 채소를 넣은 홋카이도 삿포로에서 시작한 카레입니다.", "taste": "향신료 향 · 깊은 육수 · 큼직한 구운 채소", "tip": "매운 정도와 국물 종류를 고를 수 있는 가게가 많아요. 밥을 떠서 국물에 적셔 먹습니다."}},
    "오므라이스": {"ja": "オムライス", "search": ["オムライス"], "match": ["オムライス", "omurice"], "allergy": ["egg"], "info": {"desc": "케첩 볶음밥을 얇은 달걀로 감싸거나 반숙 달걀을 올린 일본식 양식입니다.", "taste": "부드러운 달걀 · 새콤달콤한 케첩·데미글라스 소스", "tip": "킷사텐·양식집 점심 메뉴로 많이 나와요."}},

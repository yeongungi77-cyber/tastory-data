  "computed_rules": {
    "jp_experience": {
      "not_visited": 0,
      "visited": 1,
      "visitedHighCount": {
        "questionId": "JP_VISIT_COUNT",
        "optionIds": [
          "4_6",
          "7plus"
        ],
        "value": 2
      },
      "unansweredVisitCount": "visited로 간주하여 1",
      "clamp": [
        0,
        2
      ]
    },
    "cold_start": {
      "not_visited": 2,
      "visited_anchorCount_0": 1,
      "visited_anchorCount_1plus": 0,
      "phase1_note": "Anchor는 2차 범위이므로 1차에서는 anchorCount가 항상 0이다. 방문자의 cold_start는 1이다."
    }
  },
  "result_display": {
    "numericAxisThreshold": 1,
    "includeWhenAbsoluteValueAtLeast": 1,
    "eligibleAxisTypes": [
      "taste",
      "restaurant",
      "trip",
      "food_detail"
    ],
    "eligibleRequires": "range가 있는 numeric 축이며 stateful이 아닌 축",
    "excludedAxisTypes": [
      "context",
      "food",
      "experience",
      "safety",
      "filter"
    ],
    "groups": [
      {
        "id": "primary",
        "label": "주요 미식 취향",
        "axisTypes": [
          "taste",
          "restaurant",
          "trip"
        ],
        "maxHighlights": 5,
        "note": "주 미각(taste)·음식점/행동(restaurant·trip) 축. 결과의 전체 취향 요약이다."
      },
      {
        "id": "food_detail",
        "label": "음식별 세부 취향",
        "axisTypes": [
          "food_detail"
        ],
        "maxHighlights": 3,
        "note": "like로 답한 음식·매운 음식에서만 묻는 세부 취향. 주요 취향과 같은 자리를 두고 경쟁하지 않는다.",
        "contextLabels": {
          "taste_ramen_broth": "라멘에서는",
          "taste_ramen_noodle": "라멘에서는",
          "taste_sushi_raw": "초밥에서는",
          "taste_sushi_fatness": "초밥에서는",
          "taste_spicy_detail": "매운 음식을 고를 때는"
        }
      }
    ],
    "sortBy": "absoluteValueDesc",
    "tieBreak": "axes 배열 순서",
    "groupRule": "각 그룹 안에서 sortBy·tieBreak로 정렬하고 그룹별 maxHighlights까지 고른다. 그룹끼리는 경쟁하지 않는다. resultHighlights 저장 형식({axisId, value, label} 배열)은 그대로이며 primary 다음 food_detail 순서로 저장한다. 화면은 axis type으로 두 그룹을 나눠 표시하고, food_detail 항목에는 contextLabels를 앞에 붙여 보여 준다(예: \"라멘에서는 진하고 묵직한 국물\").",
    "fallback": {
      "title": "뚜렷한 쏠림이 적어요",
      "body": "현재 응답에서는 한쪽으로 뚜렷하게 치우친 취향이 적습니다. 실제 일본 음식점 경험이 쌓이면 TASTORY의 추천 기준이 더 구체화될 수 있어요."
    },
    "fallbackRule": "primary 그룹 후보가 없으면 fallback 문구를 표시한다. food_detail 후보가 있으면 fallback과 함께 표시한다."
  },
  "result_signals": [

{
  "engineVersion": "1.0",
  "schemaStatus": "IMPLEMENTED_PARAMETERS_REQUIRE_USER_VALIDATION",
  "basedOn": {
    "tastory": "v1.29",
    "axes": "2.3.1",
    "storage": "2.1",
    "questions": "2.3",
    "foods": "1.0"
  },
  "outputs": [
    "estimatedFit",
    "evidenceConfidence",
    "coverage",
    "explanations",
    "safetyGate",
    "discoveryStatus"
  ],
  "missingStates": [
    "unanswered",
    "never_tried",
    "cannot_recall",
    "unknown",
    "neutral",
    "dislike"
  ],
  "rawInputMapping": {
    "foodGenre": {
      "like": 80,
      "neutral": 50,
      "dislike": 20,
      "never_tried": null,
      "unanswered": null
    },
    "actualFoodRating": {
      "1": 0,
      "2": 25,
      "3": 50,
      "4": 75,
      "5": 100
    },
    "surveyTasteAxisScale": [
      -2,
      -1,
      0,
      1,
      2
    ]
  },
  "tasteFeatureModel": {
    "formula": "50 + 50 * (tasteAnswer / 2) * foodAttributeIntensity",
    "tasteAnswerRange": [
      -2,
      2
    ],
    "foodAttributeIntensityRange": [
      0,
      1
    ],
    "foodAttributeApplicabilityRange": [
      0,
      1
    ],
    "attributeFit": "sum(axisFit * applicability * sourceConfidence) / sum(applicability * sourceConfidence)",
    "excludedLegacyAxes": [
      "taste_richness"
    ],
    "pendingValidationAxes": [
      "taste_umami"
    ],
    "missingAxisRule": "omit_axis_not_as_neutral",
    "unapprovedCalibrationRule": "do_not_infer_from_perception_or_tolerance",
    "interpretation": "Neutral for absent flavor even when user likes strong flavor; only salient intensity boosts or penalizes"
  },
  "prior": {
    "genreWeightWhenBoth": 0.45,
    "attributeWeightWhenBoth": 0.55,
    "onePresentRule": "use_available",
    "bothMissingForCalculation": 50,
    "zeroEvidencePublishedScore": null,
    "strength": 2.0
  },
  "evidence": {
    "unit": "unique sourceEventId per target food",
    "weight": {
      "exactConsumedAndFoodRated": 1.0,
      "exactDeepTestAnswer": 0.7,
      "curatedRelatedMax": 0.25,
      "uncuratedCategoryOverlap": 0.0,
      "restaurantOverallRatingOnly": 0.0
    },
    "singlePathPerSourceEvent": true,
    "sumCap": 4.0,
    "ratingFit": "(rating1to5 - 1) * 25",
    "publishedFit": "(priorStrength * prior + sum(weight * ratingFit)) / (priorStrength + sum(weight))",
    "actualRequires": [
      "consumedConfirmed",
      "canonicalFoodId",
      "perFoodRating"
    ],
    "update": "recompute_from_raw_no_incremental_duplication",
    "plannedTripVisitRule": "if linked to itinerary, visitedConfirmed required before constructing consumption event",
    "historicalFoodRule": "manual confirmed consumption permitted without restaurant/place/date"
  },
  "confidence": {
    "genreBaseEvidence": 0.6,
    "attributeBaseEvidence": 0.4,
    "eventEvidence": "sumAppliedEvidenceWeights",
    "formula": "n / (n + 2)",
    "lowBelow": 0.34,
    "highFrom": 0.67,
    "isProbability": false
  },
  "safetyGate": {
    "confirmed_conflict": "exclude_auto_recommendation",
    "unknown_or_unverified": "hold_for_confirmation",
    "no_known_conflict_with_source": "candidate_without_safety_guarantee",
    "cannotOverrideAllergyWithTasteScore": true
  },
  "discovery": {
    "explicitNeverTried": "confirmed_untried",
    "noExperienceRecord": "experience_not_recorded",
    "consumedConfirmed": "experienced",
    "neverTreatNoRecordAsProvenNeverTried": true
  },
  "collection": {
    "unlockRequires": "confirmedConsumedFoodId",
    "unlikedFoodStillUnlocks": true,
    "pastDateUnknownAllowed": true,
    "collectionCategoryNotAwardedAsFood": true,
    "historicalBadgesImmutable": true
  },
  "storageProposal": {
    "location": "profileStore.experienceLedgerV1",
    "cache": "tasteProfile.engineV1",
    "legacyAnchorData": "preserve_and_exclude_until_owner_assigned",
    "planSchemaChange": false,
    "backupNeedsLedger": true,
    "retestPreserveLedger": true,
    "cacheRebuildable": true
  },
  "furtherValidationRequired": true
}

{
  "version": "2.3",
  "purpose": "일본 미식 여행에서 개인의 음식·음식점·미식 경험 선호를 추정하기 위한 동적 질문 풀",
  "branching_schema": {
    "showIf": "조건 객체",
    "grammar": {
      "all": [
        {
          "q": "QUESTION_ID",
          "eq": "optionId"
        }
      ],
      "any": [
        {
          "q": "QUESTION_ID",
          "gte": 1
        }
      ],
      "not": [
        {
          "q": "QUESTION_ID",
          "item": "ramen",
          "state": "like"
        }
      ]
    },
    "predicate_keys": [
      "q",
      "eq",
      "gte",
      "lte",
      "item",
      "state"
    ],
    "multi_state_rule": "item+state를 사용한다.",
    "single_rule": "q+eq/gte/lte를 사용한다.",
    "question_and_section_support": true,
    "evaluation": {
      "all": "나열한 predicate가 모두 참이면 참 (AND)",
      "any": "나열한 predicate 중 하나라도 참이면 참 (OR)",
      "not": "나열한 predicate가 모두 거짓이면 참 (NOT-ANY)",
      "combine": "한 객체에 all/any/not이 여러 개 있으면 존재하는 그룹을 모두 AND로 결합한다. 그룹 안의 항목은 predicate만 허용하며 all/any/not 중첩은 허용하지 않는다.",
      "unanswered_reference": "참조 질문이 미응답이면 predicate는 거짓이다. 따라서 all/any 조건은 거짓, not 조건은 참이 된다.",
      "eq": "single은 optionId, scale은 정수와 같은지 비교한다.",
      "gte_lte": "single은 선택한 option의 value, scale은 응답 정수와 비교한다. 비교 대상이 null이면 predicate는 거짓이다.",
      "item_state": "multi_state 질문에서 해당 itemId의 상태가 state와 같은지 비교한다. entry가 없으면 거짓이다."
    }
  },
  "display_order": "sections 배열 순서, 그 안에서 questions 배열 순서로 노출한다. showIf가 참조하는 질문은 참조하는 질문보다 앞에 있어야 한다.",
  "phases": {
    "1": "질문 흐름 + 저장 + 결과",
    "2": "실제 음식점 Anchor (phase 2 표시 항목은 1차 구현에서 노출하지 않는다)"
  },
  "food_dictionary_ref": "foods.json",
  "principles": [
    "TASTORY는 일본 미식 여행 프로그램이다. 모든 질문은 일본 여행 중 음식점·음식·식사 경험 추천에 실제 도움이 되어야 한다.",
    "전체 질문을 사용자에게 노출하지 않는다. 공통 질문 후 답변에 따라 필요한 질문만 분기한다.",
    "질문 풀은 실제 노출 문항 수보다 훨씬 크며 지속적으로 확장할 수 있다.",
    "먹어본 적 없음과 싫어함과 미응답을 구분한다.",
    "실제 일본 음식점 경험은 일반 자기보고와 분리된 강한 경험 데이터로 저장한다.",
    "알레르기·식이 제한은 취향 점수와 분리한다.",
    "미식 테스트 결과는 개인 취향의 초기 추정이며 실제 방문 경험으로 보정될 수 있다."
  ],
  "sections": [
